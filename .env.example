# ─────────────────────────────────────────────────────────────────
# .env.example — Plantilla de variables de entorno para AguaFix API
# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas .env a Git ni lo incluyas en la imagen Docker.
# ─────────────────────────────────────────────────────────────────

# ── Servidor ────────────────────────────────────────────────────
PORT=3000

# ── Base de datos PostgreSQL ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=aguafix_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=aguafix_db

# ── Correo (SMTP) ────────────────────────────────────────────────
# Ejemplo con Gmail (usar App Password, no la contraseña real de Google)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASSWORD=CHANGE_ME_MAIL_APP_PASSWORD
MAIL_FROM="AguaFix <tu_correo@gmail.com>"
MAIL_TO=cuadrilla@tuorganizacion.com

# ── AWS S3 ───────────────────────────────────────────────────────
# Las credenciales de AWS se leen automáticamente por el SDK desde:
#   1. Variables de entorno (recomendado para Docker / CI):
#        AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY
#   2. Perfil de credenciales local (~/.aws/credentials)
#   3. IAM Role asociado a la instancia EC2 / ECS (recomendado en producción)
#
# Región y bucket SÍ son obligatorios:
AWS_REGION=us-east-1
AWS_S3_BUCKET=nombre-de-tu-bucket-s3

# Credenciales de IAM (solo si NO usas IAM Role ni perfil local)
AWS_ACCESS_KEY_ID=CHANGE_ME_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_SECRET_ACCESS_KEY

# URL pública base (opcional). Déjala vacía si no usas CloudFront.
# Si la defines, las URLs devueltas tendrán el formato: <base_url>/reports/<uuid>-nombre.jpg
# Si no, se usa: https://<bucket>.s3.<region>.amazonaws.com/<key>
AWS_S3_PUBLIC_BASE_URL=

# ── Docker Hub ───────────────────────────────────────────────────
# Solo necesario para levantar con compose.yaml:
DOCKER_USER=tu_usuario_dockerhub
